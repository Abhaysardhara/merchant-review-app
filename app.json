{
  "expo": {
    "name": "Review Reach",
    "slug": "merchant-review-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#1E2B7A"
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Review Reach to access your camera to scan QR codes at merchant counters."
        }
      ],
      "expo-font"
    ],
    "assetBundlePatterns": [
      "**/*"
    ],
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#1E2B7A"
      },
      "package": "com.reviewreach.app",
      "config": {
        "googleMaps": {
          "apiKey": "GOOGLE_MAPS_API_KEY"
        }
      }
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.reviewreach.app",
      "config": {
        "googleMapsApiKey": "GOOGLE_MAPS_API_KEY"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "c3dadfd5-6f3a-4f2d-9500-39e9e5247811"
      }
    }
  }
}
