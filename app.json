{
  "expo": {
    "name": "ReviewReach: Google Reviews QR",
    "slug": "merchant-review-app",
    "scheme": "reviewreach",
    "version": "1.0.0",
    "description": "AI-powered Google review generator for local businesses. Create QR codes, collect 5-star reviews, and boost your online reputation effortlessly.",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "primaryColor": "#4F46E5",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#1E2B7A"
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Allow ReviewReach to access your camera to scan QR codes at merchant counters."
        }
      ],
      "expo-font",
      "@react-native-google-signin/google-signin"
    ],
    "assetBundlePatterns": [
      "**/*"
    ],
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#1E2B7A",
        "monochromeImage": "./assets/adaptive-icon.png"
      },
      "googleServicesFile": "./google-services.json",
      "package": "com.reviewreach.app",
      "versionCode": 1,
      "permissions": [
        "CAMERA",
        "INTERNET",
        "VIBRATE"
      ],
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyDhvYzvwNkEvilUq_ixLQ2dxz8tBGKGu7M"
        }
      },
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "abhaysardhara.github.io",
              "pathPrefix": "/merchant-review-app"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.reviewreach.app",
      "buildNumber": "1",
      "config": {
        "googleMapsApiKey": "AIzaSyDhvYzvwNkEvilUq_ixLQ2dxz8tBGKGu7M"
      },
      "associatedDomains": [
        "applinks:abhaysardhara.github.io"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "locales": {
      "en": "./locales/en.json"
    },
    "extra": {
      "eas": {
        "projectId": "c3dadfd5-6f3a-4f2d-9500-39e9e5247811"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/c3dadfd5-6f3a-4f2d-9500-39e9e5247811"
    }
  }
}
