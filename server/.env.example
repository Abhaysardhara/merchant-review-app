# Deepgram Speech-to-Text
DEEPGRAM_API_KEY=your_deepgram_api_key

# Google Gemini
GEMINI_API_KEY=your_gemini_api_key

# Google Places API
GOOGLE_MAPS_API_KEY=your_google_maps_api_key

# Firebase project (merchant branch data)
FIREBASE_PROJECT_ID=review-reach-58103
# Service-account JSON on one line (Firebase console → Project settings → Service accounts).
# Alternatively set GOOGLE_APPLICATION_CREDENTIALS to the JSON file path.
FIREBASE_SERVICE_ACCOUNT=

# Security
# Random string, at least 32 characters (e.g. `openssl rand -hex 32`). Required when NODE_ENV=production.
SESSION_SECRET=
# Browser origins allowed to call the API, comma-separated
ALLOWED_ORIGINS=https://abhaysardhara.github.io
# Daily per-branch limits for paid AI calls
DAILY_AI_BUDGET_PER_BRANCH=300
DAILY_VOICE_BUDGET_PER_BRANCH=100

# Server
NODE_ENV=development
PORT=3000
